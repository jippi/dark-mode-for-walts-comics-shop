{
  "manifest_version": 3,
  "name": "Dark Mode for Walt's Comic Shop (unofficial)",
  "description": "Unofficial dark theme for waltscomicshop.com. Collects no data.",
  "version": "2.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["*://waltscomicshop.com/*", "*://*.waltscomicshop.com/*"],
    "css": ["dark.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["logo-dark.svg"],
    "matches": ["*://waltscomicshop.com/*", "*://*.waltscomicshop.com/*"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "walts-comic-shop-dark@unofficial",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
